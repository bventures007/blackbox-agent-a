# Copy to infra/compose/.env (the wrapper does this at setup). Never put credentials here; secrets live in .secrets/.
BLACKBOX_PROJECT=blackbox-agent-a
BLACKBOX_PORT=19080
BLACKBOX_VERSION=0.1.0-dev
BLACKBOX_IMAGE_NODE=blackbox-agent-a/node:0.1.0-dev
BLACKBOX_IMAGE_ENGINE=blackbox-agent-a/engine:0.1.0-dev
POSTGRES_DIGEST=
ENGINE_TENANT_BUDGET_MIB=64
ENGINE_GLOBAL_BUDGET_MIB=768
MCP_HTTP_ENABLED=0
