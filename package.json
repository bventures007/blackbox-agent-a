{
  "name": "blackbox-local-pilot",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <26",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "vitest run --config tests/vitest.integration.config.ts",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "contracts:fixtures": "pnpm --filter @blackbox/contracts run fixtures"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "tsx": "4.20.6",
    "@types/node": "22.19.1"
  }
}
