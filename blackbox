#!/usr/bin/env python3
"""Host wrapper. No global installation, implicit volume deletion or shared secrets."""
import os, pathlib, secrets, subprocess, sys, json, datetime, uuid
root=pathlib.Path(__file__).resolve().parent
runtime=root/'.runtime'
sys.path.insert(0,str(root/'scripts'))
from host_runtime import compose_config, protected_directory, RuntimeConfigError, _validate_file
def config(create=False,port=None,require_keys=True):
 compose_config(runtime,create=create,port=port,require_keys=require_keys)
 return ['docker','compose','--env-file',str(runtime/'compose.env'),'-f',str(root/'infra/compose/compose.yaml')]
def run(args):return subprocess.call(args,cwd=root)
command=sys.argv[1] if len(sys.argv)>1 else 'help'
try:
 protected_directory(runtime,True)
 logdir=runtime/'logs';protected_directory(logdir,True);logfile=logdir/'wrapper.jsonl'
 if logfile.exists()and logfile.stat().st_size>8*1024*1024:logfile.replace(logdir/'wrapper.jsonl.1')
 stamp=datetime.datetime.now(datetime.timezone.utc).isoformat()
 record={'schema_version':1,'record_id':str(uuid.uuid4()),'occurred_at':stamp,'observed_at':stamp,'level':'INFO','event_name':'wrapper.command','message':'Host command started','component':'wrapper','service_version':'0.1.0','instance_id':str(uuid.uuid4()),'scope':'installation'}
 fd=os.open(logfile,os.O_CREAT|os.O_APPEND|os.O_WRONLY|os.O_NOFOLLOW,0o600)
 with os.fdopen(fd,'w')as f:
  _validate_file(os.fstat(f.fileno()),logfile.name);f.write(json.dumps(record)+'\n')
except (OSError,RuntimeConfigError):print('setup_log_unavailable: log persistence failed',file=sys.stderr)

if command=='logs':sys.exit(run(['python3',str(root/'scripts/diagnostics.py'),*sys.argv[2:]]))
if command=='diagnostics' and len(sys.argv)>2 and sys.argv[2]=='export':sys.exit(run(['python3',str(root/'scripts/diagnostics.py'),*sys.argv[3:]]))
if command=='restore':
 import argparse,getpass
 from backup_restore import restore,finish_restore
 from backup_codec import BackupFormatError
 parser=argparse.ArgumentParser(prog='./blackbox restore')
 parser.add_argument('backup');parser.add_argument('--to',required=True,type=pathlib.Path);parser.add_argument('--port',type=int,default=18755)
 options=parser.parse_args(sys.argv[2:])
 try:
  if not sys.stdout.isatty():raise RuntimeConfigError('Protected interactive terminal required for restore and owner-key issuance.')
  if options.backup=='resume':finish_restore(options.to.expanduser().absolute())
  else:
   secret=getpass.getpass('Backup recovery key / Wiederherstellungsschlüssel: ').encode()
   restore(root,pathlib.Path(options.backup).expanduser(),options.to,secret,options.port)
   finish_restore(options.to.expanduser().absolute())
 except (RuntimeConfigError,BackupFormatError,OSError) as error:raise SystemExit(str(error))
 sys.exit(0)
if command=='backup':
 from backup_operations import enroll,generation
 from backup_codec import BackupFormatError
 try:
  if len(sys.argv)==4 and sys.argv[2]=='configure':
   if not sys.stdout.isatty():raise RuntimeConfigError('Protected interactive terminal required for recovery-key issuance.')
   secret=enroll(root,pathlib.Path(sys.argv[3]))
   print('Save this separate backup recovery key in your password manager. It is shown once; keep it apart from this installation and backups.')
   print('Speichere diesen separaten Wiederherstellungsschlüssel im Passwortmanager. Er wird einmal angezeigt; getrennt von Installation und Sicherungen aufbewahren.')
   print(secret.decode(),end='')
  elif len(sys.argv)==2:
   result=generation(root);print('Encrypted backup completed: '+result['generation'])
  else:raise RuntimeConfigError('Usage: ./blackbox backup [configure DESTINATION]')
 except (RuntimeConfigError,BackupFormatError,OSError) as error:raise SystemExit(str(error))
 sys.exit(0)
if command=='doctor':
 print('Blackbox local pilot developer runtime; Apple Silicon; loopback port 18741. Container runtime required.')
 sys.exit(run(['docker','version','--format','{{.Client.Version}} {{if .Server}}{{.Server.Version}}{{end}}']))
if command in ['build','up','down','status','test','setup','reset-access']:
 extra=sys.argv[2:];port=None
 if '--port' in extra:
  if command not in ['build','setup'] or len(extra)!=2 or extra[0]!='--port':raise SystemExit('--port is supported only by explicit build/setup.')
  try:port=int(extra[1])
  except ValueError:raise SystemExit('Invalid loopback port.')
  extra=[]
 try:c=config(create=command in ['build','setup'],port=port,require_keys=command not in ['down','status'])
 except RuntimeConfigError as error:raise SystemExit(str(error))
 args={'build':['build'],'up':['up','-d','postgres','engine','api','worker'],'down':['stop'],'status':['ps'],'test':['--profile','test','up','-d','fixture'],'setup':['run','--rm','tooling','pnpm','exec','tsx','scripts/setup.ts'],'reset-access':['run','--rm','tooling','pnpm','exec','tsx','scripts/setup.ts','reset']}[command] if command!='build' else ['build','api','engine']
 if command in ['up','down','setup','reset-access']:
  from backup_operations import operation_lock
  try:
   with operation_lock(runtime):
    if (runtime/'maintenance.json').exists():raise RuntimeConfigError('Unfinished host maintenance. Recover it before changing service state.')
    result=run(c+args+extra)
  except RuntimeConfigError as error:raise SystemExit(str(error))
  sys.exit(result)
 sys.exit(run(c+args+extra))
print('Usage: ./blackbox doctor|build|setup|up|down|status|test|reset-access|backup')
print('Development preview: encrypted backup creation is implemented; restore/upgrade, scheduling and the release package remain in progress.')
